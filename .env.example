# Copy this file to .env and replace these placeholders with your own values.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Scopes ที่ต้องใช้สำหรับ pipeline นี้
# user-read-recently-played : ดึงประวัติการฟังล่าสุด
# user-top-read             : ดึง top artists/tracks
# playlist-read-private     : ดึง playlist ส่วนตัว
